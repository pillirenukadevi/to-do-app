<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo Manager - Modern Task Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav>
        <a href="/" class="nav-brand">
            <div class="brand-icon">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <span class="brand-text">TaskMaster</span>
        </a>

        <div class="nav-links">
            <% if (user) { %>
                <a href="/todos" class="nav-link">My Todos</a>
                <span class="nav-user">
                    <span class="user-avatar"><%= user.firstName ? user.firstName[0].toUpperCase() : 'U' %></span>
                    <%= user.firstName %>
                </span>
                <form action="/logout" method="POST" style="display:inline; margin:0;">
                    <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
                </form>
            <% } else { %>
                <a href="/login" class="nav-link">Sign In</a>
                <a href="/signup" class="btn btn-primary btn-sm">Get Started Free</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <div class="hero">
            <div class="hero-pill">
                <span>✨ Supercharge Your Productivity</span>
            </div>

            <h1>
                Organize your work, <br>
                <span class="hero-gradient">achieve your daily goals.</span>
            </h1>

            <p>
                A fast, secure, and intuitive personal task manager designed to keep you on schedule and focused on what matters most.
            </p>

            <div class="hero-actions">
                <% if (user) { %>
                    <a href="/todos" class="btn btn-primary">
                        <span>Go to My Dashboard</span>
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                <% } else { %>
                    <a href="/signup" class="btn btn-primary">
                        <span>Create Free Account</span>
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                    <a href="/login" class="btn btn-secondary">
                        <span>Log In</span>
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 TaskMaster Todo Manager &bull; Built with Node.js, Express & PostgreSQL</p>
    </footer>

</body>
</html>