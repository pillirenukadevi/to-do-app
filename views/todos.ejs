<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tasks - TaskMaster</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav>
        <a href="/" class="nav-brand">
            <div class="brand-icon">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <span class="brand-text">TaskMaster</span>
        </a>

        <div class="nav-links">
            <a href="/todo" class="btn btn-primary btn-sm">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>Add Todo</span>
            </a>

            <% if (user) { %>
                <span class="nav-user">
                    <span class="user-avatar"><%= user.firstName ? user.firstName[0].toUpperCase() : 'U' %></span>
                    <%= user.firstName %>
                </span>
                <form action="/logout" method="POST" style="display:inline; margin:0;">
                    <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
                </form>
            <% } %>
        </div>
    </nav>

    <div class="container">

        <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
            <% messages.forEach(message => { %>
                <div class="alert success">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span><%= message %></span>
                </div>
            <% }) %>
        <% } %>

        <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
            <% errors.forEach(error => { %>
                <div class="alert error">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span><%= error %></span>
                </div>
            <% }) %>
        <% } %>

        <!-- Stats Grid -->
        <% 
            const totalCount = todos.length;
            const completedCount = todos.filter(t => t.completed).length;
            const pendingCount = totalCount - completedCount;
        %>
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-num"><%= totalCount %></span>
                <span class="stat-label">Total Tasks</span>
            </div>
            <div class="stat-card">
                <span class="stat-num" style="color: #d97706;"><%= pendingCount %></span>
                <span class="stat-label">Pending</span>
            </div>
            <div class="stat-card">
                <span class="stat-num" style="color: #059669;"><%= completedCount %></span>
                <span class="stat-label">Completed</span>
            </div>
        </div>

        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <div>
                <h1>My Todos</h1>
                <p class="subtitle" style="margin-bottom: 0;">Stay organized and track your daily progress.</p>
            </div>
            <a href="/todo" class="btn btn-primary">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>New Todo</span>
            </a>
        </div>

        <!-- Todos List -->
        <% if (todos.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">📝</div>
                <div class="empty-title">No todos yet!</div>
                <div class="empty-subtitle">You have a clean slate. Create your first task to get started on your goals.</div>
                <a href="/todo" class="btn btn-primary" style="margin-top: 0.5rem;">
                    Create Your First Todo
                </a>
            </div>
        <% } else { %>
            <div class="todos-list">
                <% todos.forEach(todo => { %>
                    <div class="todo-card <%= todo.completed ? 'completed' : '' %>">
                        <div class="todo-info">
                            <h2 class="todo-title"><%= todo.title %></h2>
                            <% if (todo.description) { %>
                                <p class="todo-desc"><%= todo.description %></p>
                            <% } %>
                            <div class="todo-meta">
                                <% if (todo.completed) { %>
                                    <span class="badge badge-completed">
                                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                        </svg>
                                        Completed
                                    </span>
                                <% } else { %>
                                    <span class="badge badge-pending">
                                        Pending
                                    </span>
                                <% } %>

                                <span class="due-chip">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                    Due: <%= todo.dueDate %>
                                </span>
                            </div>
                        </div>

                        <div class="todo-actions">
                            <form action="/todos/<%= todo.id %>/complete" method="POST" style="display:inline; margin:0;">
                                <button type="submit" class="btn btn-sm <%= todo.completed ? 'btn-secondary' : 'btn-success' %>">
                                    <% if (todo.completed) { %>
                                        Mark Pending
                                    <% } else { %>
                                        ✓ Complete
                                    <% } %>
                                </button>
                            </form>

                            <a href="/edit-todo/<%= todo.id %>" class="btn btn-secondary btn-sm">
                                Edit
                            </a>

                            <form action="/todos/<%= todo.id %>/delete" method="POST" style="display:inline; margin:0;">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this todo?');">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

    </div>

    <footer>
        <p>&copy; 2026 TaskMaster Todo Manager</p>
    </footer>

</body>
</html>